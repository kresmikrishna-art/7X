DATABASE_URL=postgresql+psycopg://postcode:postcode@localhost:5432/postcode
CORS_ORIGINS=http://localhost:3000

# Optional: a regex tested against the request Origin, matched in addition to CORS_ORIGINS.
# Useful for platforms like Vercel that mint a new URL per deployment/preview -- set this
# once to your project's pattern instead of updating CORS_ORIGINS after every deploy.
# Example for a Vercel project named "my-app": https://my-app(-[a-zA-Z0-9-]+)?\.vercel\.app
CORS_ORIGIN_REGEX=

# Optional: enables /api/v1/geocode and /api/v1/reverse-geocode (Google Geocoding API).
# Leave blank to run without Google geocoding -- the rest of the app works normally.
GOOGLE_MAPS_API_KEY=
